# No trailing slash: a symlinked node_modules (how an agent worktree borrows the
# real one) is not a directory, and `node_modules/` would not match it.
node_modules
dist/
*.log
.DS_Store
release/

# Agent worktrees are checkouts of this same repo; `git add -A` would otherwise
# commit them as embedded gitlinks.
.claude/worktrees/

# Project metadata written by Claudebox itself, when this repo is brought into a
# Box as a Project (Import writes it; `claudebox-session` reads it). It names one
# Sandbox User's Workspace slug and seed prompt — local to that Box, not source.
.claudebox/

# Python bytecode
__pycache__/
*.pyc
