#!/usr/bin/env python3
"""agentbox-session <slug> — the single Box-side entry point that turns a
Project slug into its running Claude Code session (ticket 02).

Both the web console (server.py) and the Launcher reach a Project's Claude ONLY
through this program, so launching is driven entirely by data on the volume: an
unknown or crafted slug can never spawn anything.

  - On a TTY (the console's pty): attach to the tmux session, creating it on the
    first open. The seed prompt runs only for a fresh session; re-opening a live
    session re-attaches without reseeding (that's `tmux new-session -A`).
  - Off a TTY (the Launcher's `docker exec`): just ensure the session exists,
    creating it detached if absent. Never touches a session that's already live.

A template's seed prompt is CONSUMED on the open that creates the session: it is
popped from project.json before `claude` starts. Attaching isn't the only way a
reopen skips reseeding — once the Box (or tmux) restarts, the session is gone,
and without consuming it every reopen would re-send the prompt and the agent
would redo the work it already did.

The seed prompt is handed to `claude` as a SINGLE argv, never interpolated into a
shell string, so a prompt full of shell metacharacters cannot execute a command.
Claude keeps `--dangerously-skip-permissions`: the container is the boundary
(ADR 0001), not the per-action prompts.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys

WORKSPACE = os.environ.get("AGENTBOX_WORKSPACE", "/workspace")
# A copy of the Launcher's SLUG_RE (core/projects.ts), which Python cannot
# import; launcher/test/projects.test.ts compares the two patterns as text.
# Applied with fullmatch, never match: Python's `$` also matches just before a
# trailing newline, so `re.match` would accept "demo\n" where the Launcher's
# identical JavaScript pattern rejects it.
SLUG_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")


def fail(msg: str) -> None:
    print(f"agentbox-session: {msg}", file=sys.stderr)
    raise SystemExit(1)


def consume_seed(meta_path: str) -> str | None:
    """Pop `seedPrompt` off the Project's metadata and return it — once, ever."""
    with open(meta_path, encoding="utf-8") as f:
        meta = json.load(f)
    seed = meta.pop("seedPrompt", None)
    if seed:
        tmp = meta_path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(meta, f, indent=2)
        os.replace(tmp, meta_path)  # atomic: a crash never leaves a half-written meta
    return seed


def session_is_live(slug: str) -> bool:
    return subprocess.run(["tmux", "has-session", "-t", f"={slug}"], capture_output=True).returncode == 0


def main(argv: list[str]) -> None:
    if len(argv) != 1:
        fail("usage: agentbox-session <slug>")
    slug = argv[0]
    if not SLUG_RE.fullmatch(slug):
        fail(f"invalid Project slug: {slug!r}")

    cwd = os.path.join(WORKSPACE, slug)
    meta_path = os.path.join(cwd, ".agentbox", "project.json")
    if not os.path.isfile(meta_path):
        fail(f"no such Project: {slug!r}")

    live = session_is_live(slug)

    claude = ["claude", "--dangerously-skip-permissions"]
    if not live:
        seed = consume_seed(meta_path)
        if seed:
            claude.append(seed)  # single argv — metacharacters can't execute

    if sys.stdout.isatty():
        os.execvp("tmux", ["tmux", "new-session", "-A", "-s", slug, "-c", cwd, *claude])
    elif not live:
        subprocess.run(["tmux", "new-session", "-d", "-s", slug, "-c", cwd, *claude], check=True)


if __name__ == "__main__":
    main(sys.argv[1:])
