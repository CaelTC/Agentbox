		{"id":"e6","fromNode":"door","fromSide":"right","toNode":"workspace","toSide":"left","color":"1","label":"Upload · Export · Import · Delete"},
		{"id":"e7","fromNode":"window","fromSide":"right","toNode":"console","toSide":"left","label":"WebSocket, 127.0.0.1 only"},
