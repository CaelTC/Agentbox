		{"id":"e12","fromNode":"tmux","fromSide":"bottom","toNode":"agent","toSide":"top"},
		{"id":"e13","fromNode":"agent","fromSide":"right","toNode":"home","toSide":"left","label":"its login"},
		{"id":"e14","fromNode":"agent","fromSide":"top","toNode":"workspace","toSide":"bottom","label":"all work lands here"},
