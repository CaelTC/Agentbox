{
  "name": "agentbox-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "The Agentbox Launcher — the double-clickable macOS app that is a Sandbox User's entire interface to Agentbox.",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && npm run assets",
    "assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/renderer',{recursive:true});for(const f of ['index.html','styles.css'])fs.copyFileSync('src/renderer/'+f,'dist/renderer/'+f);fs.cpSync('src/renderer/assets','dist/renderer/assets',{recursive:true})\"",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-packager . Agentbox --platform=darwin --out=release --overwrite --app-bundle-id=com.agentbox.launcher --icon=assets/icon.icns --ignore=\"/(src|test|release|\\.scratch|install)($|/)\"",
    "package:win": "npm run build && electron-packager . Agentbox --platform=win32 --arch=x64 --out=release --overwrite --icon=assets/icon.ico --ignore=\"/(src|test|release|\\.scratch|install)($|/)\""
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@types/node": "^20.14.0",
    "electron": "^43.2.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {}
}
